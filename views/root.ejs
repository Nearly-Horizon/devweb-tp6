<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>Réducteur d'URL</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <h1>Réducteur d'URL</h1>
    <p class="subtitle">
      Rendu serveur — API v2
      <span class="count">
        <%= count %> lien<%= count > 1 ? 's' : '' %> enregistré<%= count > 1 ? 's' : '' %>
      </span>
    </p>
  </header>

  <main class="card">
    <form method="post" action="/api-v2/" id="submit-link">
      <div class="field">
        <label for="url">Entrez l'URL à réduire</label>
        <input
          name="url"
          id="url"
          type="url"
          placeholder="https://perdu.com"
          autocomplete="url"
          spellcheck="false"
          required
        />
      </div>
      <button type="submit">Réduire l'URL</button>
    </form>

    <% if (typeof error !== 'undefined' && error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <% if (typeof shortUrl !== 'undefined' && shortUrl) { %>
      <div class="result">
        <p>Votre lien court est prêt :</p>
        <a
          class="short-url"
          href="<%= baseUrl %>/api-v2/<%= shortUrl %>"
        ><%= baseUrl %>/api-v2/<%= shortUrl %></a>
        <div class="actions">
          <a href="<%= baseUrl %>/api-v2/<%= shortUrl %>" target="_blank" rel="noopener">
            <button type="button" class="secondary">Ouvrir</button>
          </a>
        </div>
        <p class="info">
          Redirige vers&nbsp;: <code><%= origin %></code>
        </p>
      </div>
    <% } %>
  </main>

  <footer>
    <a href="/client.html">Client AJAX</a>
    <span class="sep">·</span>
    <a href="/api-docs">Documentation API</a>
  </footer>
</body>
</html>