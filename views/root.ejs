<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Réducteur d'URL</title>
    <style>
        body { font-family: sans-serif; max-width: 600px; margin: 2rem auto; padding: 1rem; }
        input, button { padding: 0.5rem; font-size: 1rem; }
        input { width: 70%; }
        .result { margin-top: 1rem; padding: 1rem; background: #f0f0f0; border-radius: 4px; }
        .error { color: red; }
    </style>
</head>
<body>
    <h1>Réducteur d'URL</h1>
    <p>Nombre de liens : <%= count %></p>

    <form method="post" action="/api-v2/" id="submit-link">
        <label for="url">Type the URL to shorten</label><br>
        <input name="url" id="url" type="url" placeholder="https://perdu.com" required />
        <button type="submit">Submit</button>
    </form>

    <% if (typeof shortUrl !== 'undefined' && shortUrl) { %>
        <div class="result">
            <p>Lien créé : <a href="/api-v2/<%= shortUrl %>"><%= baseUrl %>/api-v2/<%= shortUrl %></a></p>
        </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
        <p class="error"><%= error %></p>
    <% } %>
</body>
</html>